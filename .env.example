# Copy this file to .env.local for local development.
# Do not commit .env.local or real API keys.

MPT_API_ENDPOINT=http://127.0.0.1:8080/api/v1/videos
MPT_DIR=../MoneyPrinterTurbo
DIRECTOR_RUNS_DIR=../director-runs
DIRECTOR_DEFAULT_DURATION_SECONDS=60
DIRECTOR_DEFAULT_PLATFORM=douyin
# Passed through to MoneyPrinterTurbo as voice_name. Provider credentials stay in MPT/provider config.
DIRECTOR_DEFAULT_VOICE_NAME=gemini:Zephyr-Female

# DeepSeek is used for repetitive script/search-term generation.
# The workflow also reads macOS Keychain service codex.deepseek.api_key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Codex CLI is used for director judgment and final semantic review.
# Codex auth should stay in the user's Codex config/login, not in this repo.
CODEX_EXECUTABLE=codex

# API stock materials. Pexels is preferred; Pixabay is explicit fallback only.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional bridge to a separate social uploader project.
SOCIAL_UPLOAD_DIR=
